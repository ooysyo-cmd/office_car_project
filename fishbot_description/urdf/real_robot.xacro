<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="real_fishbot">

    <!-- base_footprint：投影在地面的虚拟点，Nav2 用 -->
    <link name="base_footprint" />

    <!-- base_link：机器人质心坐标系 -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.12" radius="0.10" />
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.1 1.0 0.5" />
            </material>
        </visual>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <!-- TODO: 实测后修改 Z 偏移 = 轮径/2 - 底板厚度 -->
        <origin xyz="0.0 0.0 0.07" rpy="0.0 0.0 0.0" />
    </joint>

    <!-- IMU -->
    <link name="imu_link" />
    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <!-- TODO: 实测安装位置 -->
        <origin xyz="0.0 0.0 0.02" />
    </joint>

    <!-- 激光雷达 -->
    <link name="laser_link" />
    <joint name="laser_joint" type="fixed">
        <parent link="base_link" />
        <child link="laser_link" />
        <!-- TODO: 实测安装位置 -->
        <origin xyz="0.0 0.0 0.10" />
    </joint>

</robot>
